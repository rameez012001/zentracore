{
  "_version": "1.76.0",
  "sap.app": {
    "id": "maintenancerequest",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.20.0",
      "toolsId": "0d2b7448-30a1-4858-b153-81e9af44f0d2"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/my/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "MaintenanceRequest-manage": {
          "semanticObject": "MaintenanceRequest",
          "action": "manage",
          "title": "{{flpTitle}}",
          "subTitle": "{{flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          },
          "icon": "sap-icon://wrench"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.143.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.f": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "maintenancerequest.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": [{
        "uri":"css/custom.css"
      }]
    },
    "routing": {
      "config": {
        "flexibleColumnLayout": {
          "defaultTwoColumnLayoutType": "TwoColumnsMidExpanded",
          "defaultThreeColumnLayoutType": "ThreeColumnsEndExpanded"
        },
        "routerClass": "sap.f.routing.Router"
      },
      "routes": [
        {
          "pattern": ":?query:",
          "name": "MaintenanceRequestList",
          "target": [
            "MaintenanceRequestList"
          ]
        },
        {
          "pattern": "MaintenanceRequest({key}):?query:",
          "name": "MaintenanceRequestObjectPage",
          "target": [
            "MaintenanceRequestList",
            "MaintenanceRequestObjectPage"
          ]
        },
        {
          "name": "TechnicalObjectObjectPage",
          "pattern": "TechnicalObject({TechnicalObjectKey}):?query:",
          "target": [
            "MaintenanceRequestList",
            "TechnicalObjectObjectPage"
          ]
        }
      ],
      "targets": {
        "MaintenanceRequestList": {
          "type": "Component",
          "id": "MaintenanceRequestList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/MaintenanceRequest",
              "variantManagement": "None",
              "navigation": {
                "MaintenanceRequest": {
                  "detail": {
                    "route": "MaintenanceRequestObjectPage"
                  }
                },
                "TechnicalObject": {
                  "detail": {
                    "route": "TechnicalObjectObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              },
              "defaultTemplateAnnotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#tableView",
              "views": {
                "paths": [
                  {
                    "key": "tableView",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#tableView"
                  },
                  {
                    "key": "tableView1",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#tableView1",
                    "entitySet": "TechnicalObject"
                  }
                ]
              },
              "initialLoad": "Enabled"
            }
          },
          "controlAggregation": "beginColumnPages",
          "contextPattern": ""
        },
        "MaintenanceRequestObjectPage": {
          "type": "Component",
          "id": "MaintenanceRequestObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/MaintenanceRequest"
            }
          },
          "controlAggregation": "midColumnPages",
          "contextPattern": "/MaintenanceRequest({key})"
        },
        "TechnicalObjectObjectPage": {
          "type": "Component",
          "id": "TechnicalObjectObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "navigation": {},
              "contextPath": "/TechnicalObject",
              "sectionLayout": "Tabs"
            }
          },
          "controlAggregation": "midColumnPages",
          "contextPattern": "/TechnicalObject({TechnicalObjectKey})"
        }
      }
    },
    "rootView": {
      "viewName": "sap.fe.templates.RootContainer.view.Fcl",
      "type": "XML",
      "async": true,
      "id": "appRootView"
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
