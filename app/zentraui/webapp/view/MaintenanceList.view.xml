

<mvc:View
		class="sapUiSizeCompact"
		controllerName="zentraui.controller.MaintenanceList"
		xmlns="sap.m"
		xmlns:mvc="sap.ui.core.mvc"
        >

	<Table growing="true" growingThreshold="10"
				items="{path : '/MaintenanceRequest',
					parameters : {
						$count : true,
						$$getKeepAliveContext : true,
						$$patchWithoutSideEffects : true
					}}">
			
			<columns>
				<Column hAlign="Center" width="9em">
					<Text text="ID"/>
				</Column>
				<Column>
					<Text text="Title"/>
				</Column>
				<Column hAlign="Center">
					<Text text="Priority"/>
				</Column>
				<Column hAlign="Center">
					<Text text="Status"/>
				</Column>
                <Column>
					<Text text="Technician"/>
				</Column>
			</columns>
			<ColumnListItem type="Navigation" press=".onListItemPressed">
				<Text text="{technicalobject_ID}"/>
				<Text text="{title}"/>
				<Text text="{priority}"/>
				<Text text="{status}"/>
			</ColumnListItem>
		</Table>		

</mvc:View>
