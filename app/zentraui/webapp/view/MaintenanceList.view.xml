

<mvc:View
		class="sapUiSizeCompact"
		controllerName="zentraui.controller.MaintenanceList"
		xmlns="sap.m"
		xmlns:mvc="sap.ui.core.mvc"
        >

	<Table growing="true" growingThreshold="10"
				items="{
        path: '/MaintenanceRequest',
        parameters: { $$updateGroupId : 'maintenanceBatch' }
    }" id="MaintenanceRequest">
			<headerToolbar>
				<Toolbar>				
					<Button icon="sap-icon://add" id="create" press=".onCreateMaintenanceRequest"
						text="Create" tooltip="Create Maintenance Request"/>
						<Button icon="sap-icon://add" id="onSaveReq" press=".onSaveReq"
						text="Save" tooltip="Save"/>
				</Toolbar>
			</headerToolbar>
			<columns>
				<Column>
					<!-- <Text text="Title"/> -->
					<Label text="Title" tooltip="Title" />
				</Column>
				<Column hAlign="Center">
					<Text text="Priority"/>
				</Column>
				<Column hAlign="Center">
					<Text text="Status"/>
				</Column>
                <Column>
					<Text text="Technician"/>
				</Column>
			</columns>
			<ColumnListItem type="Navigation" press=".onListItemPressed">
				<cells>
					<Input textFormatMode="KeyValue" value="{title}"/>
					<ObjectStatus
						text="{priority}"
						state="{ path:'priority', formatter:'.formatPriorityState' }"/>
					<ObjectStatus
						text="{status}"
						state="{ path:'status', formatter:'.formatStatusState' }"/>
					<Text text="{technician.name}"/>
				</cells>
			</ColumnListItem>

		</Table>		

</mvc:View>
