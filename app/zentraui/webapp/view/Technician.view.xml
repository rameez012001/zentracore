<mvc:View
		class="sapUiSizeCompact"
		controllerName="zentraui.controller.Technician"
		xmlns="sap.m"
		xmlns:mvc="sap.ui.core.mvc"
        >

	<Table growing="true" growingThreshold="10"
				items="{path : '/Technician',
					parameters : {
						$count : true,
						$$getKeepAliveContext : true,
						$$patchWithoutSideEffects : true
					}}">
			<headerToolbar>
				<Toolbar>				
					<Button icon="sap-icon://add" id="createRowTechnician" press=".onCreateRowTechnician"
						text="Create" tooltip="Add Technician"/>
				</Toolbar>
			</headerToolbar>
			<columns>
				<Column hAlign="Center">
					<Text text="Name"/>
				</Column>
				<Column hAlign="Center">
					<Text text="Username"/>
				</Column>
				<Column hAlign="Center">
					<Text text="workload"/>
				</Column>
			</columns>
			<ColumnListItem type="Navigation" press=".onListItemPressed">
				<!-- <Text text="{name}"/> -->
				<Input textFormatMode="KeyValue" value="{name}"/>
				<Input textFormatMode="KeyValue" value="{technicianUserName}"/>
				<Input textFormatMode="KeyValue" value="{workload}"/>
			</ColumnListItem>
		</Table>		

</mvc:View>
