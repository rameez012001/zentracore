

<mvc:View
		class="sapUiSizeCompact"
		controllerName="zentraui.controller.TechnicalObjectPage"
		xmlns="sap.m"
		xmlns:mvc="sap.ui.core.mvc"
        >

	<Table growing="true" growingThreshold="10"
				items="{path : '/TechnicalObject',
					parameters : {
						$count : true,
						$$getKeepAliveContext : true,
						$$patchWithoutSideEffects : true
					}}">
			
			<columns>
				<Column hAlign="Center" width="9em">
					<Text text="Equipment"/>
				</Column>
				<Column>
					<Text text="Equipment Name"/>
				</Column>
				<!-- <Column>
					<Text text="Maintenance Plant"/>
				</Column> -->
				<Column>
					<Text text="Manufacturer"/>
				</Column>
                <Column hAlign="Center">
					<Text text="Status"/>
				</Column>
			</columns>
			<ColumnListItem type="Navigation" press=".onListItemPressed">
				<Image src="{imageUrl}" decorative="false" width="60px">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="NeverOverflow"/>
                    </layoutData>
			    </Image>
				<Text text="{technicalobject}"/>
				<!-- <Text text="{maintenanceplant}"/> -->
				<Text text="{manufacturer}"/>
                <Text text="{systemstatus}"/>
			</ColumnListItem>
		</Table>		

</mvc:View>
