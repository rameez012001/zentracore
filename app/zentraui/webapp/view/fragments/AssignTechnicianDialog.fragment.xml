<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="assignTechnicianDialog"
        title="Assign Technician"
        draggable="true"
        resizable="true">

        <VBox class="sapUiSmallMargin">
            <Label text="Technician ID"/>
            <Input
                id="technicianInput"
                placeholder="Enter technician ID"/>
        </VBox>

        <beginButton>
            <Button
                text="Assign"
                type="Emphasized"
                press="handleAssignConfirm"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press="handleAssignCancel"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>
