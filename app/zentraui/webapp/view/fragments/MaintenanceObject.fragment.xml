<core:FragmentDefinition
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:ux="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:m="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:mdc="sap.ui.mdc"
    xmlns:mdcvh="sap.ui.mdc.valuehelp"
    xmlns:mdcValueHelpContent="sap.ui.mdc.valuehelp.content">

<m:Page showHeader="false" floatingFooter="true">

        <ux:ObjectPageLayout
            id="ObjectPageLayout"
            isChildPage="true"
            upperCaseAnchorBar="false">

            <!-- HEADER -->
            <ux:headerTitle>
                <ux:ObjectPageHeader
                    id="headerForTest"
                    objectTitle="{title}"
                    objectSubtitle="{description}">

                    <ux:actions>
                        <ux:ObjectPageHeaderActionButton
                            icon="sap-icon://refresh"
                            text="Refresh"/>

                        <m:Button
                            text="Assign Technician"
                            type="Emphasized"
                            press="handleAssignTechnician"/>
                        <m:Button
                            text="Fixed"
                            type="Success"
                            press="handleFixed"
                            enabled="{path: 'status', formatter: '.isFixedEnabled'}"/>
                    </ux:actions>

                </ux:ObjectPageHeader>
            </ux:headerTitle>

            <!-- HEADER CONTENT -->
            <ux:headerContent>
                <layout:VerticalLayout>
                    <m:ObjectStatus title="Title" text="{title}"/>
                    <m:ObjectStatus title="Priority" text="{priority}"/>
                    <m:ObjectStatus
                        title="Status"
                        text="{status}"
                        state="{path:'status'}"/>
                    <m:ObjectStatus title="Technician" text="{technician_ID}"/>
                </layout:VerticalLayout>
            </ux:headerContent>
        </ux:ObjectPageLayout>
    </m:Page>
</core:FragmentDefinition>
